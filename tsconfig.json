{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true
  },
  "include": ["src/**/*.js", "Demo/**/*.js"],
  // Стенд `Demo/edge` — не код библиотеки, а воспроизведение чужой интеграции, и
  // кнопка в нём лежит дословной копией: она написана по правилам стороннего
  // проекта (контракт `onClick` там без параметров, а поля не сужены) и под
  // `strict` этого репозитория не собирается. Правка копии означала бы, что стенд
  // проверяет уже не тот код, который стоило воспроизвести.
  "exclude": ["Demo/edge/**/*.js"]
}
